# ==========================================================
# Production environment for the AWS host (deploy/aws/.env).
# Copy with:  bash deploy/aws/init-env.sh
# NEVER commit deploy/aws/.env.
# ==========================================================

# --- Public entry point -----------------------------------
# Leave ":80" while you have no domain (serves http://<elastic-ip>).
# Later set e.g. SITE_ADDRESS=finance.yourdomain.com and Caddy
# obtains/renews the TLS certificate automatically.
SITE_ADDRESS=:80
ACME_EMAIL=

# --- Image tag (bump to force a clean rebuild) ------------
IMAGE_TAG=1

# --- Postgres ---------------------------------------------
POSTGRES_DB=finance_chitti
POSTGRES_USER=postgres
# Generated by init-env.sh (hex only, URL-safe).
POSTGRES_PASSWORD=

# --- App --------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=60

# Same-origin in production, so CORS is only needed for extra clients.
CORS_ORIGINS=["http://localhost:3000"]

# --- First admin (created once by the migrate service) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# --- WhatsApp Cloud API (optional) ------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_VERIFY_TOKEN=

# --- Backups (filled from terraform output) ---------------
BACKUP_BUCKET=
AWS_REGION=ap-south-1
